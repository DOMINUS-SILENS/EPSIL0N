{
  "action": "ApproveInvoice",
  "command": "ApproveInvoiceCommand",
  "aggregate": "Invoice",
  "visibleIf": ["role:FinanceManager", "role:Approver"],
  "enabledIf": ["approval_state:pending", "lifecycle_state:submitted"],
  "requiresSecondaryAuth": false,
  "requiresJustification": false,
  "truthOutcomes": {
    "200": "CommittedState",
    "202": "PendingState",
    "403": "PermissionBlock",
    "409": "ConflictBanner",
    "422": "ExceptionDrawer"
  }
}
