{
  "action": "ResolveApprovalRequest",
  "command": "ResolveApprovalRequestCommand",
  "aggregate": "ApprovalRequest",
  "visibleIf": ["role:Approver", "role:Admin"],
  "enabledIf": ["approval_state:pending"],
  "requiresSecondaryAuth": false,
  "requiresJustification": true,
  "truthOutcomes": {
    "200": "CommittedState",
    "202": "PendingState",
    "403": "PermissionBlock",
    "409": "ConflictBanner",
    "422": "ExceptionDrawer"
  }
}
