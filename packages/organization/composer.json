{
    "name": "spiral-organization/organization",
    "description": "EPSILON Organization Bounded Context - Tenant Administration",
    "type": "library",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../kernel"
        }
    ],
    "require": {
        "php": "^8.3",
        "spiral-kernel/epsilone": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Spiral\\Organization\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spiral\\Organization\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "spiral/composer-publish-plugin": true
        }
    }
}
